    <Color x:Key="PrimaryTint">#E3F1F1</Color>
    <Color x:Key="Background">#F3F7F7</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="Ink">#102426</Color>
    <Color x:Key="Muted">#455B5D</Color>
