<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CitasMedicas.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:CitasMedicas.App.Views"
    FlyoutBehavior="Disabled"
    Shell.TabBarBackgroundColor="{StaticResource Surface}"
    Shell.TabBarForegroundColor="{StaticResource PrimaryDark}"
    Shell.TabBarTitleColor="{StaticResource Ink}"
    Shell.TabBarUnselectedColor="{StaticResource Muted}">

    <TabBar>
        <ShellContent
            Title="Paciente"
            Icon="tab_paciente"
            Route="paciente"
            AutomationId="tab_paciente"
            SemanticProperties.Description="Pestaña Paciente"
            ContentTemplate="{DataTemplate views:RegistroPage}" />
        <ShellContent
            Title="Médicos"
            Icon="tab_medicos"
            Route="medicos"
            AutomationId="tab_medicos"
            SemanticProperties.Description="Pestaña Médicos"
            ContentTemplate="{DataTemplate views:MedicosPage}" />
        <ShellContent
            Title="Horarios"
            Icon="tab_horarios"
            Route="horarios"
            AutomationId="tab_horarios"
            SemanticProperties.Description="Pestaña Horarios"
            ContentTemplate="{DataTemplate views:HorariosPage}" />
        <ShellContent
            Title="Solicitar"
            Icon="tab_solicitar"
            Route="solicitar"
            AutomationId="tab_solicitar"
            SemanticProperties.Description="Pestaña Solicitar"
            ContentTemplate="{DataTemplate views:SolicitarPage}" />
        <ShellContent
            Title="Historial"
            Icon="tab_historial"
            Route="historial"
            AutomationId="tab_historial"
            SemanticProperties.Description="Pestaña Historial"
            ContentTemplate="{DataTemplate views:HistorialPage}" />
    </TabBar>

</Shell>
