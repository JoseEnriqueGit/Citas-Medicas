<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CitasMedicas.App.Views.RegistroPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CitasMedicas.App.Controls"
    xmlns:vm="clr-namespace:CitasMedicas.App.ViewModels"
    x:DataType="vm:RegistroViewModel"
    Title="Registro de paciente">
    <Grid RowDefinitions="Auto,*">
        <controls:AppBar
            Title="{Binding Titulo}"
            PatientName="{Binding Estado.NombrePaciente}" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="16">

                <VerticalStackLayout Spacing="16" IsVisible="{Binding MostrarFormulario}">
                    <Border Style="{StaticResource BannerInfo}" IsVisible="{Binding MostrarInfo}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Image
                                Source="ic_info_primary"
                                WidthRequest="20"
                                HeightRequest="20"
                                VerticalOptions="Start"
                                AutomationProperties.IsInAccessibleTree="False" />
                            <Label Grid.Column="1"
                                Style="{StaticResource BannerInfoText}"
                                Text="Tus datos se guardan solo en este teléfono y se usan para solicitar citas." />
                        </Grid>
                    </Border>

                    <Border
                        x:Name="ErrorBanner"
                        Style="{StaticResource BannerError}"
                        IsVisible="{Binding HayErrores}"
                        SemanticProperties.Description="{Binding ResumenErrores}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Image
                                Source="ic_alert_danger"
                                WidthRequest="20"
                                HeightRequest="20"
                                VerticalOptions="Start"
                                AutomationProperties.IsInAccessibleTree="False" />
                            <Label Grid.Column="1" Style="{StaticResource BannerErrorText}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding ResumenErrores}" FontAttributes="Bold" />
                                        <Span Text=" antes de continuar." />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </Grid>
                    </Border>

                    <controls:FormField
                        x:Name="CampoNombre"
                        Caption="Nombre completo"
                        Placeholder="Ej. María Fernández Peña"
                        Text="{Binding Nombre, Mode=TwoWay}"
                        Error="{Binding ErrorNombre}"
                        MaxLength="100" />

                    <controls:FormField
                        x:Name="CampoCedula"
                        Caption="Cédula"
                        Placeholder="000-0000000-0"
                        Hint="Con guiones: 000-0000000-0"
                        Text="{Binding Cedula, Mode=TwoWay}"
                        Error="{Binding ErrorCedula}"
                        Keyboard="Default"
                        MaxLength="13" />

                    <controls:FormField
                        x:Name="CampoTelefono"
                        Caption="Teléfono"
                        Placeholder="809-555-0142"
                        Text="{Binding Telefono, Mode=TwoWay}"
                        Error="{Binding ErrorTelefono}"
                        Keyboard="Telephone"
                        MaxLength="20" />

                    <controls:FormField
                        x:Name="CampoCorreo"
                        Caption="Correo electrónico"
                        IsOptional="True"
                        Placeholder="nombre@correo.com"
                        Text="{Binding Correo, Mode=TwoWay}"
                        Error="{Binding ErrorCorreo}"
                        Keyboard="Email"
                        MaxLength="100" />

                    <VerticalStackLayout Spacing="4">
                        <Label Style="{StaticResource FieldLabel}" Text="Fecha de nacimiento" />
                        <Grid>
                            <Border Style="{StaticResource FieldBorder}" MinimumHeightRequest="48">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding HayErrorFecha}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource Danger}" />
                                        <Setter Property="StrokeThickness" Value="2" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label
                                        Text="{Binding FechaTexto}"
                                        VerticalOptions="Center"
                                        TextColor="{StaticResource Placeholder}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding TieneFecha}" Value="True">
                                                <Setter Property="TextColor" Value="{StaticResource Ink}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Image
                                        Grid.Column="1"
                                        Source="ic_calendar_muted"
                                        WidthRequest="24"
                                        HeightRequest="24"
                                        VerticalOptions="Center"
                                        AutomationProperties.IsInAccessibleTree="False" />
                                </Grid>
                            </Border>
                            <DatePicker
                                x:Name="SelectorFecha"
                                Opacity="0"
                                MinimumDate="1900-01-01"
                                SemanticProperties.Description="Fecha de nacimiento, toca para elegir"
                                DateSelected="OnFechaSeleccionada" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" IsVisible="{Binding HayErrorFecha}">
                            <Image
                                Source="ic_alert_danger"
                                WidthRequest="16"
                                HeightRequest="16"
                                VerticalOptions="Start"
                                Margin="0,2,0,0"
                                AutomationProperties.IsInAccessibleTree="False" />
                            <Label Grid.Column="1" Style="{StaticResource ErrorLabel}" Text="{Binding ErrorFecha}" />
                        </Grid>
                    </VerticalStackLayout>

                    <Button
                        Text="{Binding TextoBoton}"
                        Command="{Binding RegistrarCommand}"
                        SemanticProperties.Description="{Binding TextoBoton}" />
                    <Button
                        Style="{StaticResource TextButton}"
                        Text="Cancelar"
                        IsVisible="{Binding MostrarCancelar}"
                        Command="{Binding CancelarEdicionCommand}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="16" IsVisible="{Binding Completado}">
                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center" Padding="0,8,0,0">
                        <Border
                            WidthRequest="72"
                            HeightRequest="72"
                            HorizontalOptions="Center"
                            BackgroundColor="{StaticResource SuccessTint}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 36">
                            <Image
                                Source="ic_check_big"
                                WidthRequest="40"
                                HeightRequest="40"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                AutomationProperties.IsInAccessibleTree="False" />
                        </Border>
                        <Label
                            Style="{StaticResource DialogTitleLabel}"
                            HorizontalTextAlignment="Center"
                            Text="Registro completado" />
                        <Label
                            Style="{StaticResource HintLabel}"
                            HorizontalTextAlignment="Center"
                            Text="Ya puedes ver médicos, consultar horarios y solicitar citas." />
                    </VerticalStackLayout>

                    <Border Style="{StaticResource CardBorder}">
                        <Grid
                            ColumnDefinitions="96,*"
                            RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                            ColumnSpacing="12"
                            RowSpacing="8">
                            <Label Style="{StaticResource HintLabel}" Text="Nombre" />
                            <Label Grid.Column="1" Style="{StaticResource BoldLabel}" FontSize="14" Text="{Binding DatoNombre}" />
                            <Label Grid.Row="1" Style="{StaticResource HintLabel}" Text="Cédula" />
                            <Label Grid.Row="1" Grid.Column="1" Style="{StaticResource BoldLabel}" FontSize="14" Text="{Binding DatoCedula}" />
                            <Label Grid.Row="2" Style="{StaticResource HintLabel}" Text="Teléfono" />
                            <Label Grid.Row="2" Grid.Column="1" Style="{StaticResource BoldLabel}" FontSize="14" Text="{Binding DatoTelefono}" />
                            <Label Grid.Row="3" Style="{StaticResource HintLabel}" Text="Correo" />
                            <Label Grid.Row="3" Grid.Column="1" Style="{StaticResource BoldLabel}" FontSize="14" Text="{Binding DatoCorreo}" />
                            <Label Grid.Row="4" Style="{StaticResource HintLabel}" Text="Nacimiento" />
                            <Label Grid.Row="4" Grid.Column="1" Style="{StaticResource BoldLabel}" FontSize="14" Text="{Binding DatoNacimiento}" />
                        </Grid>
                    </Border>

                    <Label Style="{StaticResource HintLabel}" Text="Paciente activo en este teléfono." />

                    <Button
                        Text="Solicitar una cita"
                        Command="{Binding SolicitarCommand}" />
                    <Button
                        Style="{StaticResource SecondaryButton}"
                        Text="Editar mis datos"
                        Command="{Binding EditarCommand}" />
                    <Button
                        Style="{StaticResource SecondaryButton}"
                        Text="Registrar otro paciente"
                        Command="{Binding OtroCommand}" />

                    <VerticalStackLayout Spacing="8" IsVisible="{Binding MostrarLista}">
                        <Label Style="{StaticResource SectionLabel}" Text="Pacientes en este teléfono" />
                        <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Pacientes}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:PacienteItem">
                                    <Border
                                        Style="{StaticResource CardBorder}"
                                        MinimumHeightRequest="56"
                                        SemanticProperties.Description="{Binding Descripcion}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding CambiarCommand}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                                <Label Style="{StaticResource BoldLabel}" FontSize="14" Text="{Binding Nombre}" />
                                                <Label Style="{StaticResource HintLabel}" Text="{Binding Cedula}" />
                                            </VerticalStackLayout>
                                            <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto" ColumnSpacing="6" VerticalOptions="Center" IsVisible="{Binding Activo}">
                                                <Image
                                                    Source="ic_check_success"
                                                    WidthRequest="20"
                                                    HeightRequest="20"
                                                    VerticalOptions="Center"
                                                    AutomationProperties.IsInAccessibleTree="False" />
                                                <Label Grid.Column="1" Style="{StaticResource BoldLabel}" FontSize="14" VerticalOptions="Center" Text="Activo" />
                                            </Grid>
                                            <Image
                                                Grid.Column="1"
                                                Source="ic_chevron_muted"
                                                WidthRequest="20"
                                                HeightRequest="20"
                                                VerticalOptions="Center"
                                                IsVisible="{Binding Inactivo}"
                                                AutomationProperties.IsInAccessibleTree="False" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
