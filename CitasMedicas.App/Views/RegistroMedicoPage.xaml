<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CitasMedicas.App.Views.RegistroMedicoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CitasMedicas.App.Controls"
    xmlns:vm="clr-namespace:CitasMedicas.App.ViewModels"
    x:DataType="vm:RegistroMedicoViewModel"
    Title="Registrar médico">
    <Grid RowDefinitions="Auto,*">
        <Border
            BackgroundColor="{StaticResource Surface}"
            StrokeShape="Rectangle"
            StrokeThickness="0"
            Padding="0">
            <VerticalStackLayout>
                <VerticalStackLayout Padding="16,12,16,12">
                    <Label
                        Style="{StaticResource TitleLabel}"
                        Text="Registrar médico"
                        SemanticProperties.HeadingLevel="Level1" />
                    <Label
                        FontSize="14"
                        TextColor="{StaticResource Muted}"
                        Text="El médico quedará disponible para solicitar citas." />
                </VerticalStackLayout>
                <BoxView HeightRequest="1" Color="{StaticResource Divider}" />
            </VerticalStackLayout>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="16">
                <Border
                    Style="{StaticResource BannerError}"
                    IsVisible="{Binding HayErrores}"
                    SemanticProperties.Description="{Binding ResumenErrores}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Image
                            Source="ic_alert_danger"
                            WidthRequest="20"
                            HeightRequest="20"
                            VerticalOptions="Start"
                            AutomationProperties.IsInAccessibleTree="False" />
                        <Label Grid.Column="1" Style="{StaticResource BannerErrorText}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding ResumenErrores}" FontAttributes="Bold" />
                                    <Span Text=" antes de continuar." />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Grid>
                </Border>

                <controls:FormField
                    x:Name="CampoNombre"
                    Caption="Nombre del médico"
                    Placeholder="Ej. Dra. Marta Peña"
                    Text="{Binding Nombre, Mode=TwoWay}"
                    Error="{Binding ErrorNombre}"
                    MaxLength="100" />

                <VerticalStackLayout Spacing="8">
                    <controls:FormField
                        x:Name="CampoEspecialidad"
                        Caption="Especialidad"
                        Placeholder="Ej. Neurología"
                        Text="{Binding Especialidad, Mode=TwoWay}"
                        Error="{Binding ErrorEspecialidad}"
                        MaxLength="100" />
                    <VerticalStackLayout Spacing="4" IsVisible="{Binding HayEspecialidades}">
                        <Label Style="{StaticResource HintLabel}" Text="O elige una especialidad existente" />
                        <ScrollView
                            Orientation="Horizontal"
                            HorizontalScrollBarVisibility="Never"
                            SemanticProperties.Description="Especialidades existentes">
                            <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Especialidades}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:EspecialidadItem">
                                        <controls:ChipView
                                            Text="{Binding Nombre}"
                                            IsSelected="{Binding Seleccionada}"
                                            Command="{Binding ElegirCommand}" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </ScrollView>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <controls:FormField
                    x:Name="CampoCentro"
                    Caption="Centro médico"
                    Placeholder="Ej. Hospital San Rafael"
                    Text="{Binding Centro, Mode=TwoWay}"
                    Error="{Binding ErrorCentro}"
                    MaxLength="100" />

                <Button
                    Text="Guardar médico"
                    Command="{Binding GuardarCommand}"
                    SemanticProperties.Description="Guardar médico" />
                <Button
                    Style="{StaticResource TextButton}"
                    Text="Cancelar"
                    Command="{Binding CancelarCommand}"
                    SemanticProperties.Description="Cancelar sin guardar" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
