<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="CitasMedicas.App.Controls.AppBar"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root">
    <Border
        BackgroundColor="{StaticResource Surface}"
        Stroke="{StaticResource Divider}"
        StrokeShape="Rectangle"
        StrokeThickness="0"
        Padding="0">
        <VerticalStackLayout>
            <VerticalStackLayout Padding="16,12,16,12" Spacing="0">
                <Label
                    Style="{StaticResource TitleLabel}"
                    Text="{Binding Title, Source={x:Reference Root}}" />
                <HorizontalStackLayout Spacing="6">
                    <Image
                        x:Name="PatientIcon"
                        Source="ic_user_primary"
                        WidthRequest="16"
                        HeightRequest="16"
                        VerticalOptions="Center"
                        IsVisible="False"
                        AutomationProperties.IsInAccessibleTree="False" />
                    <Label
                        x:Name="SubtitleLabel"
                        FontSize="14"
                        TextColor="{StaticResource Muted}"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
            <BoxView HeightRequest="1" Color="{StaticResource Divider}" />
        </VerticalStackLayout>
    </Border>
</ContentView>
